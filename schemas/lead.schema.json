{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Lead",
  "description": "One prospect moving through the pipeline. Every stage reads and writes this. Owner: Ayaan. Change it only by PR with everyone's OK.",
  "type": "object",
  "required": ["lead_id", "customer_id", "person", "company", "stage", "status"],
  "properties": {
    "lead_id": {"type": "string"},
    "customer_id": {"type": "string", "description": "Which customer's brief this lead belongs to"},
    "source": {"enum": ["salesforce", "clay", "referral", "manual"], "description": "Where the lead came from. The source is not the record; the Sales DB is (docs/fleet-prompts-v2.md §2)"},
    "source_id": {"type": ["string", "null"], "description": "The lead's ID in the source system, e.g. the Salesforce Lead Id"},
    "created_at": {"type": "string", "format": "date-time", "description": "When add_lead put the lead in the lead sheet (Salesforce: CreatedDate)"},
    "updated_at": {"type": "string", "format": "date-time", "description": "Last time anything was logged for this lead"},
    "stage_times": {"type": "object", "description": "When the lead first reached each stage, e.g. {\"replied\": ..., \"handed_off\": ...}. Gives reply-to-rep time and cycle time", "additionalProperties": {"type": "string", "format": "date-time"}},
    "person": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "title": {"type": "string"},
        "email": {"type": "string"},
        "linkedin_url": {"type": "string"}
      }
    },
    "company": {
      "type": "object",
      "properties": {
        "name": {"type": "string"},
        "domain": {"type": "string"},
        "country": {"type": "string", "description": "ISO 3166-1 alpha-2, decides channel rules"},
        "employees": {"type": "integer"},
        "industry": {"type": "string"}
      }
    },
    "research": {
      "type": "object",
      "description": "Stream 1 (Kyriakos)",
      "properties": {
        "summary": {"type": "string"},
        "facts": {"type": "array", "items": {"type": "object", "properties": {"fact": {"type": "string"}, "source_url": {"type": "string"}}}},
        "enough_to_personalize": {"type": "boolean"},
        "attempts": {"type": "integer", "description": "How many times check_ready_to_write said no. After 2 the lead goes on_hold"}
      }
    },
    "positioning": {
      "type": "object",
      "description": "Stream 1 positioning (Gyula)",
      "properties": {
        "angle": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "variant": {"enum": ["research", "template"], "description": "Which arm of the research-vs-template A/B test this lead got"}
      }
    },
    "outreach": {
      "type": "object",
      "description": "Stream 2 (JD)",
      "properties": {
        "draft_subject": {"type": "string"},
        "draft_body": {"type": "string"},
        "sent_at": {"type": "string", "format": "date-time"},
        "reply_label": {"enum": ["positive", "negative", "not_now", "wrong_person", "out_of_office", "unsubscribe", null]},
        "approval": {"type": "object", "description": "Written by record_approval. send_email only sends the draft this approval covers (draft_hash)", "properties": {"decision": {"enum": ["approve", "edit", "reject"]}, "by": {"type": "string"}, "at": {"type": "string", "format": "date-time"}, "draft_hash": {"type": "string"}, "note": {"type": "string"}}},
        "follow_up_due": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "handoff": {
      "type": "object",
      "description": "Stream 3 (Slava)",
      "properties": {
        "rep_id": {"type": "string"},
        "meeting_start": {"type": "string", "format": "date-time"},
        "call_brief": {"type": "string"},
        "meeting_outcome": {"enum": ["held", "no_show", "cancelled", null], "description": "Set by the rep after the meeting with record_meeting_outcome. held counts toward the North Star (qualified meetings held)"},
        "meeting_outcome_at": {"type": ["string", "null"], "format": "date-time"}
      }
    },
    "close": {
      "type": "object",
      "description": "Auto-close, only when the brief enables it",
      "properties": {"small_deal": {"type": "boolean"}, "estimated_value_eur": {"type": ["number", "null"], "description": "Expected value per year, compared with the brief's auto_close price cap"}, "offer_link": {"type": "string"}, "paid": {"type": "boolean"}, "amount_eur": {"type": ["number", "null"], "description": "What was actually paid (Salesforce: Opportunity.Amount)"}, "closed_at": {"type": "string", "format": "date-time"}}
    },
    "stage": {"enum": ["new", "researched", "positioned", "drafted", "approved", "sent", "replied", "offer_sent", "handed_off", "closed"]},
    "status": {"enum": ["active", "won", "lost", "insufficient_data", "on_hold", "queued"], "description": "on_hold: research still thin after 2 retries. queued: positive reply waiting for a free rep. Neither is lost"},
    "loss_reason": {"type": ["string", "null"], "description": "One value from loss_reasons.json"}
  }
}
