# Copy to .env. Never commit .env.
# LangSmith: with LANGSMITH_TRACING=true and a key, every tool call is a run in LANGSMITH_PROJECT, every
# event-log row gets its trace_id, and outcomes are posted as feedback (mcp/sales_tools/tracing.py).
LANGSMITH_TRACING=true
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sales-agent
CLAY_API_KEY=
ANTHROPIC_API_KEY=

# OpenMail agent inbox (https://docs.openmail.sh). Prefer an inbox-scoped key over the account key.
# Set, send_email really sends to leads whose address is one of our own test inboxes; .test leads stay in memory.
OPENMAIL_API_KEY=
OPENMAIL_INBOX_ID=
OPENMAIL_ADDRESS=
# Our other OpenMail test inboxes a lead may use (comma-separated). OPENMAIL_ADDRESS is always included.
OPENMAIL_TEST_RECIPIENTS=

# Liquid d1 for the yes/no checks (optional; without it, Claude Haiku answers them)
LIQUID_API_KEY=

# Homepage screenshots for research (mcp/sales_tools/vision.py). The vision model uses ANTHROPIC_API_KEY.
# live: take a screenshot of real domains with no saved one (needs: uv sync --extra screenshots; uv run playwright install chromium)
SALES_SCREENSHOTS=
VISION_MODEL=claude-haiku-5-5
