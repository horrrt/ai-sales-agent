# Copy to .env. Never commit .env.
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=sales-agent
# Optional, paid Apollo plans only: lets find_leads search Apollo's API on top of the CSV exports in data/apollo/.
# Key from https://developer.apollo.io/#/keys with mixed_people/api_search + people/bulk_match
APOLLO_API_KEY=
ANTHROPIC_API_KEY=

# Liquid d1 for the yes/no checks (optional; without it, Claude Haiku answers them)
LIQUID_API_KEY=
